{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "noEmit": false,
    "outDir": "dist-electron",
    "types": ["node"],
    "isolatedModules": false
  },
  "include": ["electron/**/*.ts", "electron/**/*.cts"]
}